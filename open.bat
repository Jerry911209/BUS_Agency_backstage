@echo off
:: 設定編碼為 UTF-8，防止黑色視窗的繁體中文註解變成亂碼
chcp 65001 >nul
cls

:: 紀錄專案最外層根目錄的絕對路徑
set "ROOT_DIR=%~dp0"

echo =====================================================================
echo  🚌  智慧巴士與復康乘車管理系統 - 雙後端一鍵啟動腳本 (Jerry 智慧防禦版)
echo =====================================================================
echo.
echo ⏳ 正在同步自動化偵測兩端環境，請勿關閉隨後彈出的命令提示字元視窗...
echo.

:: -----------------------------------------------------------------
:: 💻 1. 核心升級：自動偵測 .NET MVC 是否遺失 NuGet 套件
:: -----------------------------------------------------------------
echo [1/3] 正在智慧偵測 .NET MVC 後台套件依賴完整性...
cd /d "%ROOT_DIR%"

:: 先進行無痛套件盲測 (利用 no-restore 測試是否能正常建置，藉此判斷是否有缺套件)
dotnet build --no-restore >nul 2>nul

if %errorlevel% neq 0 (
    :: 進入此區塊代表系統真的抓到有遺失套件 (可能是全新電腦或剛 Git 拉下來)
    echo.
    echo ⚠️  [偵測回報]：系統發現您的 .NET 環境遺失核心 NuGet 套件（例如 Entity Framework 等）。
    echo -----------------------------------------------------------------
    set /p mvc_choice="❓ 是否立即啟動雲端還原補裝作業？[Y/N] (預設 Y，直接按 Enter 即可)："
    
    if "%mvc_choice%"=="" set mvc_choice=Y
    if /I "%mvc_choice%"=="Y" (
        echo.
        echo ⏳ 正在連線 NuGet 伺服器進行強制還原補裝...
        dotnet restore
        echo 🎉 .NET 套件補裝完畢！
    ) else (
        echo ⏩ 已依使用者要求跳過套件補裝，將直接嘗試強行點火...
    )
    echo -----------------------------------------------------------------
) else (
    :: 進入此區塊代表套件健全，完全不吵使用者，直接秒速通關！
    echo 🎉 [偵測回報]：.NET MVC 套件環境非常完整，無須補裝！
)
echo.

:: -----------------------------------------------------------------
:: 🐍 2. 啟動 Python Flask 智慧調度 API 服務 (路徑防爆雙引號隔離視窗)
:: -----------------------------------------------------------------
echo [2/3] 正在獨立安全隔離視窗中啟動 Python Flask API...
:: 🌟 修正終極盲區：為 /D 後面的路徑強加上雙引號 ""，澈底根除路徑走火導致找不到 app.py 的閃退問題！
start "🐍 Python Flask - 智慧調度引擎 API" /D "%ROOT_DIR%DispatchAPI" cmd /k "echo ⏳ 正在檢查 Python 核心環境... && python -m pip install --upgrade pip && echo ⏳ 正在強制檢查並安裝 SQL 與 Flask 必要驅動... && python -m pip install flask flask-cors pyodbc && echo. && echo 🚀 核心套件檢查完畢！正在強制點火啟動 Flask 服務... && echo. && python app.py"

:: 稍微延遲 2 秒，確保 Python 順利建立 5000 埠口守候
timeout /t 2 >nul
echo.

:: -----------------------------------------------------------------
:: 💻 3. 啟動 ASP.NET Core MVC 主後台管理系統 (智慧雙重防爆 watch run)
:: -----------------------------------------------------------------
echo [3/3] 正在對應獨立視窗中以「熱部署監聽模式 (watch run)」引爆 .NET 主後台...
start "💻 ASP.NET Core MVC - 主後台管理系統" /D "%ROOT_DIR%" cmd /k "echo ⏳ 正在執行第一次強制編譯安全防禦... && dotnet build && echo. && echo 🚀 編譯通關！智慧熱部署監聽啟動中... && dotnet watch run"

echo.
echo =====================================================================
echo 🎉 【雙後端分流起飛】全套系統指令已全部發射完畢！
echo =====================================================================
echo 🌐 [主後台網址] 請至瀏覽器打開主視窗顯示的 Localhost 埠口
echo ⚙️  [智慧 API 端] 運作於 http://127.0.0.1:5000
echo =====================================================================
echo ※ 提示：展示或測試結束時，直接將彈出的兩個黑色視窗關閉即可。
echo.
pause