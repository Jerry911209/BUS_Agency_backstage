@using Microsoft.AspNetCore.Http
@{
    // 關鍵修正：將 Layout 設為 null，代表這個頁面不使用母版頁面
    // 注意：如果你是在 _Layout.cshtml 內部，這行通常不需要，
    // 但如果你是想讓某個頁面跳脫母版，則在那頁設定。
    // 這裡我們保留你原本的邏輯。
    Layout = null;

    // 取得當前登入者的角色
    var role = Context.Session.GetString("UserRole");
}
<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 復康巴士管理後台</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
            .sidebar {
                min-height: 100vh;
                background-color: #212529;
                box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
            }

            .nav-link {
                color: #adb5bd;
                padding: 15px 20px;
            }

            .nav-link:hover {
                color: #fff;
                background-color: #343a40;
            }

            .nav-link.active {
                color: #fff;
                background-color: #0d6efd;
            }
    </style>
</head>

<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" href="#">花蓮縣復康巴士機關後台</a>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                🏠 首頁概況
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="UserList">
                                👥 帳號權限管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-controller="Home" asp-action="AuditList">
                                📋 服務使用者審核
                            </a>
                        </li>
                        @* 新增：公告訊息管理 (CMS) 選項 *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="AnnouncementList">
                                📢 公告訊息管理
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-controller="Home" asp-action="FaqList">
                                ❓ 常見問題(FAQ)管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="VehicleManagement">
                                <i class="bi bi-truck me-2"></i> 車輛管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="DispatchList">
                                <i class="bi bi-calendar-check me-2"></i> 派車任務管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="DriverManagement">
                                <i class="bi bi-person-badge me-2"></i> 司機管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Statistics">
                                <i class="bi bi-bar-chart-line me-2"></i> 報表統計
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-controller="Home" asp-action="VehicleDispatchSystem">
                                🔀 車輛調度系統 (建置中)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="SystemLogList">
                                <i class="bi bi-journal-text"></i> 系統操作日誌
                            </a>
                        </li>
                        <li class="nav-item mt-5">
                            <a class="nav-link text-danger" asp-controller="Home" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> 登出系統
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>