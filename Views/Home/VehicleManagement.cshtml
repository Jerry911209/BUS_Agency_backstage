@model IEnumerable<BUS_Agency_backstage.Models.Vehicle>

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>🚚 車輛管理</h3>
        @* <a asp-action="EditVehicle" class="btn btn-success">+ 新增車輛</a> *@
    </div>

    <div class="container mt-4">
        <div class="d-flex justify-content-between mb-3">
            <h3>🚚 車輛管理</h3>
        </div>

        <table class="table table-hover shadow-sm border">
            <thead class="table-dark">
                <tr>
                    <th>編號</th>
                    <th>車牌號碼</th>
                    <th>違規次數</th>
                    <th>目前狀態</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.VehiclesWithStats)
                {
                    var v = item.Vehicle;
                    var count = item.ViolationCount;

                    <tr id="v-row-@v.VehicleId">
                        <td>@v.VehicleId</td>
                        <td><strong>@v.PlateNo</strong></td>
                        <td>
                            <span class="badge @(count > 3 ? "bg-danger" : "bg-secondary")">
                                @count 次
                            </span>
                        </td>
                        <td>
                            @if (v.Status == 0)
                            {
                                <span class="badge bg-success">正常</span>
                            }
                            else if (v.Status == 1)
                            {

                                <span class="badge bg-warning text-dark">維修中</span>
                            }
                            else
                            {

                                <span class="badge bg-danger">報廢</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <script>
            function deleteVehicle(id) {
                if (confirm('確定要永久刪除這部車輛嗎？')) {
                    $.post('/Home/DeleteVehicle', { id: id }, function () {
                        $('#v-row-' + id).fadeOut();
                    });
                }
            }
    </script>