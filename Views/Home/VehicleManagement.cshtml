@model IEnumerable<BUS_Agency_backstage.Models.Vehicle>

<h2 class="mt-4">🚐 車輛管理</h2>
<div class="card shadow-sm mt-3">
    <div class="card-body">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>車牌號碼</th>
                    <th>車型</th>
                    <th>可載人數</th>
                    <th>目前狀態</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            @* 關鍵修正：對應 SQL 的 [PlateNo] *@
                            <td>@item.PlateNo</td>
                            
                            @* 對應 SQL 的 [VehicleType] *@
                            <td>@item.VehicleType</td>
                            
                            @* 對應 SQL 的 [SeatCount] *@
                            <td>@item.SeatCount</td>
                            
                            <td>
                                @* 對應 SQL 的 [Status]，假設 1 是執勤中 *@
                                @if (item.Status == 1) { <span class="badge bg-success">執勤中</span> }
                                else { <span class="badge bg-secondary">維修/休息</span> }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>