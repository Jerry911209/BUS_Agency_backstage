@model BUS_Agency_backstage.Models.Booking

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">➕ 手動新增預約單</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateBooking" method="post">
                <div class="row">
                    @* 修改乘客姓名輸入框，準備串接搜尋功能 *@
                    <div class="col-12 mb-3 position-relative">
                        <label class="form-label">乘客姓名 (輸入後會自動搜尋)</label>
                        <input type="text" name="passengerName" id="passengerSearch" class="form-control"
                               autocomplete="off" required />
                        <ul id="searchList" class="list-group position-absolute w-100 shadow"
                            style="display:none; z-index:1000;"></ul>
                    </div>

                    <div class="mb-3">
                        <label>預約類型</label>
                        <select asp-for="BookingType" class="form-select">
                            <option value="1">一般預約</option>
                            <option value="2">長照預約</option>
                        </select>
                    </div>
                    @* 在搭乘時間上方加入狀態選擇 *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">初始狀態</label>
                        <select asp-for="BookingStatus" class="form-select">
                            <option value="0">待審核</option>
                            <option value="3">補件中</option>
                        </select>
                    </div>

                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label">搭乘時間</label>
                        <input asp-for="PickupTime" type="datetime-local" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">上車地點</label>
                        <input asp-for="PickupAddr" class="form-control" placeholder="請輸入完整地址" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">下車地點</label>
                        <input asp-for="DropoffAddr" class="form-control" placeholder="請輸入目的地" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">同行人數</label>
                        <input asp-for="CompanionCount" type="number" class="form-control" min="0" value="0" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">確認新增</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消返回</a>
                </div>
            </form>
        </div>
    </div>
</div>
@* ...前面的 HTML 表單代碼保持不變... *@

@section Scripts {
    <script>
        $(document).ready(function () {
            // 乘客姓名自動搜尋邏輯
            $('#passengerSearch').on('input', function() {
                let q = $(this).val();
                if(q.length < 1) { 
                    $('#searchList').hide(); 
                    return; 
                }
                
                $.get('/Home/GetPassengerList', { query: q }, function(data) {
                    let html = '';
                    if (data.length > 0) {
                        data.forEach(i => {
                            // 當點擊清單項目時，填入姓名並隱藏清單
                            html += `<li class="list-group-item list-group-item-action" 
                                        style="cursor:pointer"
                                        onclick="$('#passengerSearch').val('${i.username}'); $('#searchList').hide();">
                                        ${i.username}
                                     </li>`;
                        });
                        $('#searchList').html(html).show();
                    } else {
                        $('#searchList').hide();
                    }
                });
            });

            // 點擊頁面其他地方時隱藏搜尋清單
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#passengerSearch, #searchList').length) {
                    $('#searchList').hide();
                }
            });
        });
    </script>

    @* 引入 SweetAlert2 的 CDN *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (ViewBag.Error != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: '新增失敗',
                text: '@Html.Raw(ViewBag.Error)',
                confirmButtonText: '好，我檢查看看'
            });
        </script>
    }
}