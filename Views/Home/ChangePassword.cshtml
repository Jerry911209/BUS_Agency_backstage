<div class="container mt-5">
    <div class="card shadow mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h4 class="text-center text-danger">首次登入請修改密碼</h4>
            <hr />
            @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
            <form asp-action="ChangePassword" method="post">
                <div class="mb-3">
                    <label class="form-label">輸入新密碼</label>
                    <input type="password" name="newPassword" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">再次確認新密碼</label>
                    <input type="password" name="confirmPassword" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-warning w-100">確認修改並登入</button>
            </form>
        </div>
    </div>
</div>