@{
    Layout = "_Layout"; // 完美套用 C# 主後台的黑底導覽列
    ViewData["Title"] = "智慧車輛動態調度系統";
}

<div class="container-fluid mt-3" style="padding: 0 15px;">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
        <div>
            <h4 class="mb-1 fw-bold text-dark">🔀 智慧車輛動態調度系統</h4>
            <small class="text-muted">跨中心即時運力派遣與 GPS 軌跡稽核面板</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="seedData()" class="btn btn-outline-primary btn-sm fw-bold">🌱 初始化模擬資料</button>
            <button onclick="exportDispatchCSV()" class="btn btn-success btn-sm fw-bold">📊 匯出派遣報表 (CSV)</button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-7 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    🗺️ 跨中心車輛即時 GPS 座標地圖
                </div>
                <div class="card-body p-0 bg-light" style="position: relative;">
                    <div id="map-canvas" style="height: 500px; background: #e5e9f0; position: relative; overflow: hidden;">
                        <div class="map-grid" style="position: absolute; width:100%; height:100%; background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 40px 40px;"></div>
                        </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white fw-bold">
                    ⚠️ 異常警示行為統計 (Vehicle Alerts)
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>車牌號碼</th>
                                    <th>異常類型</th>
                                    <th>觸發次數</th>
                                    <th>最後觸發時間</th>
                                </tr>
                            </thead>
                            <tbody id="alert-summary-body">
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    📅 當日待派遣預約申請單稽核
                </div>
                <div class="card-body p-0">
                    <div id="reservation-list" style="max-height: 780px; overflow-y: auto; padding: 15px;">
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">🚏 指派調度任務</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal()"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modal-res-id">
                <div class="mb-3">
                    <p class="mb-1 text-muted small">乘車資訊</p>
                    <h6 id="modal-res-info" class="fw-bold"></h6>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">選擇調度車輛 (自動過濾維修車輛)</label>
                    <select id="modal-vehicle-select" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">選擇派遣司機</label>
                    <select id="modal-driver-select" class="form-select"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal()">取消</button>
                <button type="button" class="btn btn-primary fw-bold" onclick="submitDispatch()">確認派遣</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let data = { vehicles: [], drivers: [], reservations: [], alerts: [] };
    let activeResId = null;
    
    // 🌟 強制設定 Python API 的基地主機位址，打通跨網域連線
    const API_BASE = "http://127.0.0.1:5000";

    async function fetchJson(url, options = {}) {
        const res = await fetch(url, options);
        if (!res.ok) throw new Error(`HTTP 錯誤: ${res.status}`);
        return await res.json();
    }

    async function loadData() {
        try {
            // 🌟 將 AJAX 指向 5000 埠口的 Python API
            data.vehicles = await fetchJson(`${API_BASE}/api/vehicles`);
            data.drivers = await fetchJson(`${API_BASE}/api/drivers`);
            data.reservations = await fetchJson(`${API_BASE}/api/reservations`);
            data.alerts = [];
            
            renderReservations();
            renderMap();
            renderAlerts();
        } catch (err) {
            console.error("載入調度數據失敗:", err);
        }
    }

    function renderReservations() {
        const container = document.getElementById('reservation-list');
        if (!container) return;
        
        if (!data.reservations.length) {
            container.innerHTML = '<div class="text-center text-muted py-4">目前沒有待處理的預約申請。</div>';
            return;
        }

        container.innerHTML = data.reservations.map(res => {
            let statusBadge = '';
            let actionBtn = '';

            if (res.status === '待調度') {
                statusBadge = '<span class="badge bg-warning text-dark">待調度</span>';
                actionBtn = `<button class="btn btn-sm btn-primary fw-bold mt-2" onclick="openDispatchModal(${res.id})">⚡ 立即派遣</button>`;
            } else if (res.status === '已取消') {
                statusBadge = '<span class="badge bg-danger">已取消</span>';
            } else {
                statusBadge = '<span class="badge bg-success">' + res.status + '</span>';
            }

            return `
                <div class="card mb-3 border-start border-4 border-primary shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-primary">#${res.id} ${res.passengerName} [${res.identity}]</span>
                            ${statusBadge}
                        </div>
                        <div class="small text-secondary">
                            <div>📅 日期時間: ${res.rideDate} ${res.rideTime}</div>
                            <div>📍 上車地點: ${res.pickup}</div>
                            <div>🏁 目的地: ${res.dropoff}</div>
                        </div>
                        ${actionBtn}
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderMap() {
        const canvas = document.getElementById('map-canvas');
        if (!canvas) return;
        
        const oldMarkers = canvas.querySelectorAll('.map-marker');
        oldMarkers.forEach(m => m.remove());

        data.vehicles.forEach(v => {
            const marker = document.createElement('div');
            marker.className = 'map-marker';
            marker.style.position = 'absolute';
            marker.style.left = `${v.x}%`;
            marker.style.top = `${v.y}%`;
            marker.style.transform = 'translate(-50%, -50%)';
            marker.style.padding = '4px 8px';
            marker.style.borderRadius = '4px';
            marker.style.color = 'white';
            marker.style.fontSize = '11px';
            marker.style.fontWeight = 'bold';
            
            if (v.status === '維修中') {
                marker.style.backgroundColor = '#95a5a6';
            } else if (v.status === '出勤中') {
                marker.style.backgroundColor = '#e74c3c';
            } else {
                marker.style.backgroundColor = '#2ecc71';
            }

            marker.innerHTML = `🚌 ${v.plate}<br><span style="font-size:9px;opacity:0.8">${v.route}</span>`;
            canvas.appendChild(marker);
        });
    }

    function renderAlerts() {
        const tbody = document.getElementById('alert-summary-body');
        if (!tbody) return;
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">目前暫無超速/怠速等異常行為通報。</td></tr>';
    }

    function openDispatchModal(resId) {
        activeResId = resId;
        const res = data.reservations.find(r => r.id == resId);
        if (!res) return;

        document.getElementById('modal-res-id').value = resId;
        document.getElementById('modal-res-info').innerText = `${res.passengerName} (${res.rideDate} ${res.rideTime})`;

        const vSelect = document.getElementById('modal-vehicle-select');
        const availableVehicles = data.vehicles.filter(v => v.status !== '維修中');
        vSelect.innerHTML = availableVehicles.map(v => `<option value="${v.id}">🚌 ${v.plate} [${v.type}]</option>`).join('');

        const dSelect = document.getElementById('modal-driver-select');
        dSelect.innerHTML = data.drivers.map(d => `<option value="${d.id}">👤 ${d.name} (${d.status})</option>`).join('');

        const modal = new bootstrap.Modal(document.getElementById('dispatchModal'));
        modal.show();
    }

    async function submitDispatch() {
        const vehicleId = document.getElementById('modal-vehicle-select').value;
        const driverId = document.getElementById('modal-driver-select').value;

        try {
            const res = await fetchJson(`${API_BASE}/api/dispatch`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reservationId: activeResId, vehicleId, driverId })
            });

            if (res.success) {
                alert('任務派遣成功！狀態已實時同步至雲端。');
                const modalEl = document.getElementById('dispatchModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();
                loadData();
            }
        } catch (err) {
            alert('派遣失敗，請確認 Python API 連線狀態。');
        }
    }

    function seedData() {
        alert('共用遠端資料庫，跳過本機初始化');
    }

    function exportDispatchCSV() {
        const rows = [["案件編號", "乘客", "日期", "時間", "上車地點", "目的地", "狀態"]];
        data.reservations.forEach(item => {
            rows.push([item.id, item.passengerName, item.rideDate, item.rideTime, item.pickup, item.dropoff, item.status]);
        });
        const csv = rows.map(row => row.map(cell => '"' + String(cell ?? "").replace(/"/g, '""') + '"').join(",")).join("\n");
        const blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `DispatchReport_${new Date().toISOString().slice(0,10)}.csv`;
        link.click();
    }

    $(document).ready(function() {
        loadData();
        setInterval(loadData, 5000);
    });
</script>