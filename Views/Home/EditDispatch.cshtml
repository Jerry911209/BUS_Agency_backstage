@model BUS_Agency_backstage.Models.DispatchTask

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">📋 手動派車任務</h5>
        </div>
        <div class="card-body">
            <form asp-action="SaveDispatch" method="post">
                @* 隱藏欄位處理 TaskId *@
                <input type="hidden" asp-for="TaskId" />

                <div class="mb-3">
                    <label class="form-label">1. 選擇預約單 (待處理)</label>
                    <select asp-for="BookingId" class="form-select" required>
                        <option value="">-- 請選擇 --</option>
                        @foreach (var b in ViewBag.Bookings as List<BUS_Agency_backstage.Models.Booking>)
                        {
                            <option value="@b.BookingId">單號: @b.BookingId | 時間: @b.PickupTime?.ToString("MM/dd HH:mm")
                            </option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">2. 指派車輛</label>
                        <select asp-for="VehicleId" class="form-select" required>
                            <option value="">-- 請選擇 --</option>
                            @foreach (var v in ViewBag.Vehicles as List<BUS_Agency_backstage.Models.Vehicle>)
                            {
                                // 利用我們剛才在 Model 擴充的 IsAvailable 屬性
                                bool isDisabled = !v.IsAvailable;

                                // 狀態說明文字
                                string statusText = v.Status switch
                                {
                                    1 => " (維修中)",
                                    2 => " (報廢)",
                                    _ => ""
                                };

                                <option value="@v.VehicleId" disabled="@(isDisabled ? "disabled" : null)">
                                    @v.PlateNo (@v.VehicleType) @statusText
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">3. 指派司機</label>
                        <select asp-for="DriverId" class="form-select" required>
                            <option value="">-- 請選擇 --</option>
                            @foreach (var d in ViewBag.Drivers as List<BUS_Agency_backstage.Models.Driver>)
                            {
                                <option value="@d.DriverId">@d.DriverName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">確認指派</button>
                </div>
            </form>
        </div>
    </div>
</div>