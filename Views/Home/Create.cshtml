@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "新增調度中心系統管理人員";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">新增調度中心系統管理人員</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateUser" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label">登入帳號 (Username)</label>
                            <input type="text" name="Username" class="form-control" placeholder="請輸入英文或數字帳號" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">管理員姓名 (Real Name)</label>
                            <input type="text" name="RealName" class="form-control" placeholder="請輸入姓名" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">出生日期 (用於生成初始密碼)</label>
                            <input type="date" id="birthdayInput" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">預設登入密碼 (根據生日自動生成)</label>
                            <input type="text" id="passwordDisplay" name="Password" class="form-control bg-light" 
                                   value="請先選擇生日" readonly style="cursor: not-allowed; font-weight: bold; color: #0d6efd;" />
                            <small class="form-text text-info">
                                <i class="bi bi-info-circle"></i> 初始密碼預設為管理員生日 (西元年 YYYYMMDD)。
                            </small>
                        </div>

                        <input type="hidden" name="RoleId" value="2" />
                        <div class="mb-4">
                            <label class="form-label text-muted">設定帳號權限</label>
                            <input type="text" class="form-control bg-light" value="2 - 調度中心管理員" readonly style="cursor: not-allowed;" />
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">返回列表</a>
                            <button type="submit" class="btn btn-success">確認新增帳號</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 當生日欄位改變時，自動格式化並填入密碼欄位
            $('#birthdayInput').on('change', function() {
                let dateVal = $(this).val(); // 格式通常為 YYYY-MM-DD
                if (dateVal) {
                    // 移除橫線，轉換成 YYYYMMDD
                    let formattedPwd = dateVal.replace(/-/g, ''); 
                    $('#passwordDisplay').val(formattedPwd);
                } else {
                    $('#passwordDisplay').val('請先選擇生日');
                }
            });
        });
    </script>
}