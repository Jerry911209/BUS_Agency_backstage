@{
    ViewData["Title"] = "新增系統使用者";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">新增使用者</h4>
                </div>
                <div class="card-body">
                    <!-- 關鍵修正 1：Action 名稱必須與 Controller 中的 [HttpPost] 方法一致 -->
                    <form asp-action="CreateUser" method="post">
                        <div class="mb-3">
                            <!-- 關鍵修正 2：name 屬性必須對應 Account 模型的 Username -->
                            <label class="form-label">登入帳號 (Username)</label>
                            <input type="text" name="Username" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <!-- name 對應 PasswordHash (Controller 會處理加密) -->
                            <label class="form-label">登入密碼 (Password)</label>
                            <input type="password" name="Password" class="form-control" required />
                        </div>
                        <!-- 如果 Account 模型沒有 Name 欄位，此處可視需求保留或移除 -->
                        <div class="mb-3">
                            <label class="form-label">真實姓名 (Name)</label>
                            <input type="text" name="RealName" class="form-control" />
                        </div>
                        <select name="RoleId" class="form-select">
                            @if (Context.Session.GetString("UserRole") == "Super")
                            {
                                <option value="1">1 - 最高管理員</option>
                            }
                            <option value="5">5 - 系統管理員</option>
                            <option value="2">2 - 調度中心管理員</option>
                            <option value="3">3 - 司機</option>
                            <option value="4">4 - 一般民眾</option>
                        </select>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">返回列表</a>
                            <button type="submit" class="btn btn-success">確認新增</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>