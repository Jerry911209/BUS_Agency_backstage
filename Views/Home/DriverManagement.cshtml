@model IEnumerable<BUS_Agency_backstage.Models.Driver>

<h2 class="mt-4">👥 司機管理</h2>
<div class="card shadow-sm mt-3">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>員工編號</th>
                    <th>司機姓名</th>
                    <th>聯絡電話</th>
                    @* 如果資料庫沒存執照號碼，建議先把這一欄標題改掉或刪除 *@
                    <th>帳號關聯 (GUID)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DriverId</td>
                            <td>@item.DriverName</td>
                            <td>@item.Mobile</td>
                            <td>@item.AccountId</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">目前無司機資料</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>