@{
    Layout = null; // 登入頁不需要左側選單
}
<!DOCTYPE html>
<html>
<head>
    <title>系統登入 - 花蓮縣復康巴士</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f5f5f5; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .login-form { width: 100%; max-width: 400px; padding: 15px; background: white; border-radius: 10px; shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="login-form border shadow-sm p-4">
        <h3 class="text-center mb-4">機關後台登入</h3>
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">帳號</label>
                <input type="text" name="username" class="form-control" placeholder="請輸入帳號" required />
            </div>
            <div class="mb-3">
                <label class="form-label">密碼</label>
                <input type="password" name="password" class="form-control" placeholder="請輸入密碼" required />
            </div>
            @if (ViewBag.Error != null) {
                <div class="alert alert-danger p-2">@ViewBag.Error</div>
            }
            <button type="submit" class="btn btn-primary w-100">立即登入</button>
        </form>
    </div>
</body>
</html>