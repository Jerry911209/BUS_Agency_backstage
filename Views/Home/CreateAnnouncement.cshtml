@{
    ViewData["Title"] = "發布新公告";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">📢 發布新公告</h5>
        </div>
        <div class="card-body">
            <form asp-action="SaveAnnouncement" method="post">
                <div class="mb-3">
                    <label class="form-label">公告分類</label>
                    <select name="Category" class="form-select" required>
                        <option value="最新消息">最新消息</option>
                        <option value="系統維護">系統維護</option>
                        <option value="政策異動">政策異動</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">公告標題</label>
                    <input type="text" name="Title" class="form-control" placeholder="請輸入標題" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label">發布日期 (預約發布)</label>
                    <input type="datetime-local" name="PublishDate" class="form-control" 
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label">公告內容 (支援 HTML)</label>
                    <textarea name="Content" class="form-control" rows="8" placeholder="請輸入內容..."></textarea>
                </div>
                
                <div class="text-end">
                    <a asp-action="AnnouncementList" class="btn btn-secondary">取消</a>
                    <button type="submit" class="btn btn-primary">確認發布</button>
                </div>
            </form>
        </div>
    </div>
</div>