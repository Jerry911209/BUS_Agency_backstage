@{
    Layout = "_Layout"; // 套用 C# 後台外框
    ViewData["Title"] = "調度資料庫檢視器";
}

<div class="container-fluid mt-3">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white p-3 fw-bold">
            🗃️ 縣市政府調度資料庫內容即時瀏覽器 (測試專用面板)
        </div>
        <div class="card-body bg-light">
            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary">選擇要瀏覽的資料表 (Tables)</label>
                    <select id="tableSelect" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">限制顯示筆數</label>
                    <input type="number" id="limitInput" class="form-control" value="100" min="1" max="1000" />
                </div>
                <div class="col-md-4 pt-4">
                    <button onclick="loadTableData()" class="btn btn-primary fw-bold w-100">🔍 讀取最新數據</button>
                </div>
            </div>
        </div>
    </div>

    <div id="tableMeta" class="mb-3 d-flex gap-2"></div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div id="tableWrapper" class="table-responsive" style="min-height: 200px;">
                <div class="text-center text-muted py-5">請選擇上方資料表並點擊讀取按鈕。</div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const API_BASE = "http://127.0.0.1:5000";

    async function fetchJson(url) {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP 錯誤! 狀態碼: ${res.status}`);
        return await res.json();
    }

    async function loadTables() {
        const select = document.getElementById("tableSelect");
        select.innerHTML = '<option>正在讀取資料表清單...</option>';
        try {
            const result = await fetchJson(`${API_BASE}/api/database/tables`);
            select.innerHTML = result.tables.map(t => 
                `<option value="${t.schema}.${t.table}">${t.schema}.${t.table} (${t.rowCount} 筆資料)</option>`
            ).join("");
        } catch (error) {
            select.innerHTML = '<option>無法載入清單，請確認 Python 後端已啟動</option>';
        }
    }

    async function loadTableData() {
        const selected = document.getElementById("tableSelect").value;
        if (!selected || selected.includes("正在")) return;

        const [schema, table] = selected.split(".");
        const limit = document.getElementById("limitInput").value || 100;
        const meta = document.getElementById("tableMeta");
        const tableWrap = document.getElementById("tableWrapper");

        meta.innerHTML = `<span class="badge bg-warning text-dark">正在加載 ${selected}...</span>`;
        tableWrap.innerHTML = `<div class="text-center text-muted py-5">正在連線 SQL Server 撈取中...</div>`;

        try {
            const result = await fetchJson(`${API_BASE}/api/database/table/${encodeURIComponent(schema)}/${encodeURIComponent(table)}?limit=${encodeURIComponent(limit)}`);

            meta.innerHTML = `
                <span class="badge bg-dark">結構物：${result.schema}.${result.table}</span>
                <span class="badge bg-secondary">實體欄位：${result.columns.length} 個</span>
                <span class="badge bg-info text-dark">本次讀取：${result.rows.length} 筆</span>
            `;

            if (!result.rows.length) {
                tableWrap.innerHTML = `<div class="text-center text-muted py-5">此資料表目前沒有任何觀測資料。</div>`;
                return;
            }

            const thead = result.columns.map(c => `<th>${c}</th>`).join("");
            const tbody = result.rows.map(row => `
                <tr>
                    ${result.columns.map(c => `<td>${row[c] ?? '<span class="text-muted">NULL</span>'}</td>`).join("")}
                </tr>
            `).join("");

            tableWrap.innerHTML = `
                <table class="table table-striped table-hover mb-0 align-middle small">
                    <thead class="table-secondary"><tr>${thead}</tr></thead>
                    <tbody>${tbody}</tbody>
                </table>
            `;
        } catch (error) {
            tableWrap.innerHTML = `<div class="alert alert-danger m-3">讀取失敗！原因：${error.message}</div>`;
        }
    }

    $(document).ready(function() {
        loadTables();
    });
</script>