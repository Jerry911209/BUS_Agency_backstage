@model IEnumerable<BUS_Agency_backstage.Models.Account>

@{
    ViewData["Title"] = "系統使用者管理";
}
@using Microsoft.AspNetCore.Http
@{
    var currentRole = Context.Session.GetString("UserRole"); // 假設 Login 時存了 "Super" 或 "Admin"
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>👤 系統使用者管理</h3>
        <a asp-action="CreateUser" class="btn btn-success">+ 新增使用者</a>
    </div>
    <div class="card shadow">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>帳號</th>
                    <th>角色權限</th>
                    <th>所屬中心</th>
                    <th>狀態</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>
                            @* 關鍵修正：將 RoleId 轉為文字顯示 *@
                            @switch (user.RoleId)
                            {
                                case 1:
                                    <span class="badge bg-danger">最高管理員</span>
                                    break;
                                case 2:

                                    <span class="badge bg-primary">調度中心管理員</span>
                                    break;
                                case 3:

                                    <span class="badge bg-info text-dark">司機</span>
                                    break;
                                case 4:

                                    <span class="badge bg-success">一般民眾</span>
                                    break;
                                case 5:

                                    <span class="badge bg-warning text-dark">機關管理員</span>
                                    break;
                                case 99:

                                    <span class="badge bg-secondary">測試帳號</span>
                                    break;
                                default:

                                    <span class="badge bg-light text-dark">未知權限 (@user.RoleId)</span>
                                    break;
                            }
                        </td>
                        <td>@(user.CenterId?.ToString() ?? "未分配")</td>
                        <td>
                            @if (user.IsLocked == true)
                            {
                                <span class="text-danger">● 鎖定</span>
                            }
                            else
                            {
                                <span class="text-success">● 正常</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @* 1. 判斷是否顯示「修改/刪除」按鈕 *@
                                @if (currentRole == "Super" || (currentRole == "Admin" && user.RoleId != 1))
                                {
                                    <a asp-action="EditUser" asp-route-id="@user.AccountId"
                                       class="btn btn-sm btn-outline-primary">修改</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="deleteUser('@user.AccountId', '@user.Username')">刪除</button>
                                }
                                else
                                {
                                    <span class="text-muted small">無權限操作</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function deleteUser(id, name) {
            Swal.fire({
                title: '確定要刪除使用者嗎？',
                text: "帳號「" + name + "」將被永久移除，且無法復原！",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: '確定刪除',
                cancelButtonText: '取消'
            }).then((result) => {
                if (result.isConfirmed) {
                    // 使用 fetch 發送 POST 請求到後端
                    fetch('/Home/DeleteUser/' + id, {
                        method: 'POST'
                    }).then(response => {
                        if (response.ok) {
                            Swal.fire('已刪除', '使用者帳號已移除。', 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('錯誤', '刪除失敗，該帳號可能有關聯資料。', 'error');
                        }
                    });
                }
            })
        }
    </script>
}