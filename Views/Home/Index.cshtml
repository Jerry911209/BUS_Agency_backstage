@model IEnumerable<BUS_Agency_backstage.Models.Booking>

@{
    ViewData["Title"] = "復康巴士預約管理";
    // 取得在 Controller 中放入 ViewBag 的公告資料
    var announcements = ViewBag.Announcements as List<BUS_Agency_backstage.Models.Announcement>;
}

<div class="container-fluid pt-4">
    <!-- 📢 最新公告區塊 (CMS 整合) -->
    @if (announcements != null && announcements.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info shadow-sm border-0">
                    <h6 class="alert-heading d-flex align-items-center">
                        <i class="bi bi-megaphone-fill me-2"></i> 最新公告
                    </h6>
                    <hr>
                    <ul class="list-unstyled mb-0">
                        @foreach (var ann in announcements)
                        {
                            <li class="mb-2">
                                <span class="badge bg-primary me-2">
                                    @(ann.PublishDate.HasValue ? ann.PublishDate.Value.ToString("MM/dd") : "")
                                </span>
                                <strong>@ann.Title</strong>
                                <small class="text-muted ms-2">@Html.Raw(ann.Content)</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- 管理員控制面板 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body d-flex align-items-center">
                    <h5 class="mb-0 me-4">🛠️ 系統管理：</h5>
                    <div class="btn-group">
                        <a asp-action="UserList" class="btn btn-outline-dark">
                            <i class="bi bi-people-fill"></i> 使用者管理
                        </a>
                        <a asp-action="AnnouncementList" class="btn btn-outline-primary">
                            <i class="bi bi-megaphone"></i> 公告管理
                        </a>
                        <a asp-action="CreateUser" class="btn btn-outline-success">
                            <i class="bi bi-person-plus-fill"></i> 新增管理員
                        </a>
                        @* 新增派車管理入口 *@
                        <a asp-action="DispatchList" class="btn btn-outline-info">
                            <i class="bi bi-calendar-check"></i> 派車任務管理
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">今日總預約：@Model.Count()</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow-sm h-100">
                <div class="card-body">待審核：@Model.Count(x => x.BookingStatus == 0)</div>
            </div>
        </div>
    </div>

    <!-- 預約單列表 -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📅 預約單列表</h5>
            <a asp-action="CreateBooking" class="btn btn-sm btn-success">+ 手動新增</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>編號</th>
                            <th>乘客 ID</th>
                            <th>搭乘時間</th>
                            <th>行程路徑</th>
                            <th>目前狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BookingId</td>
                                <td><small class="text-muted">@item.PassengerId</small></td>
                                <td>
                                    @* 修正：移除多餘的 <td> 標籤，並加上 Null 檢查 *@
                                    @item.PickupTime?.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    <small>
                                        @item.PickupAddr <br />
                                        <i class="bi bi-arrow-down text-primary"></i> <br />
                                        @item.DropoffAddr
                                    </small>
                                </td>
                                <td>
                                    @* 狀態擴充：加入補件中與駁回 *@
                                    @if (item.BookingStatus == 0) { <span class="badge rounded-pill bg-warning text-dark">待審核</span> }
                                    else if (item.BookingStatus == 1) { <span class="badge rounded-pill bg-success">已排班</span> }
                                    else if (item.BookingStatus == 2) { <span class="badge rounded-pill bg-secondary">已取消</span> }
                                    else if (item.BookingStatus == 3) { <span class="badge rounded-pill bg-info text-dark">補件中</span> }
                                    else if (item.BookingStatus == 4) { <span class="badge rounded-pill bg-danger">已駁回</span> }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        @* 修改與刪除按鈕，串接對應的 JavaScript 函數 *@
                                        <button class="btn btn-sm btn-outline-primary" onclick="editBooking('@item.BookingId')">編輯</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@item.BookingId')">刪除</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 編輯預約單轉向
        function editBooking(id) {
            window.location.href = '/Home/EditBooking/' + id;
        }

        // 刪除預約單 (永久刪除)
        function confirmDelete(id) {
            if (confirm("確定要永久刪除這筆預約單嗎？")) {
                $.post('/Home/DeleteBooking', { id: id }, function () {
                    alert("刪除成功！");
                    location.reload();
                }).fail(function() {
                    alert("刪除失敗，請檢查權限。");
                });
            }
        }
    </script>
}